        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="75dp" android:layout_marginTop="8dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="9dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYSTEM LOG" android:textColor="#91A4C5" android:textSize="9sp" android:textStyle="bold"/><TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="42dp" android:background="#080D13" android:fontFamily="monospace" android:padding="6dp" android:scrollbars="vertical" android:text="Ready. VOTOL SPP + JK BMS BLE." android:textColor="#56A8FF" android:textSize="8sp"/></LinearLayout>
            <Space android:layout_width="8dp" android:layout_height="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" android:gravity="center" android:orientation="horizontal"><Button android:id="@+id/votolScan" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="SCAN VOTOL" android:textSize="9sp"/><Button android:id="@+id/votolDisconnect" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:layout_weight="1" android:text="DISCONNECT" android:textSize="9sp"/><Button android:id="@+id/jkScan" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:layout_weight="1" android:text="SCAN BMS" android:textSize="9sp"/><Button android:id="@+id/jkDisconnect" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:layout_weight="1" android:text="BMS OFF" android:textSize="9sp"/></LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/votolDevices" android:layout_width="match_parent" android:layout_height="1dp" android:text="" android:textColor="#718096" android:textSize="1sp" />
        <TextView android:id="@+id/jkDevices" android:layout_width="match_parent" android:layout_height="1dp" android:text="" android:textColor="#718096" android:textSize="1sp" />
        <Button android:id="@+id/exportLog" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:text="EXPORT LOG" android:textSize="9sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="#0C121A" android:gravity="center" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂ Dashboard" android:textColor="#00CFFF" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣ BMS" android:textColor="#A5B4C7" android:textSize="9sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙ VOTOL" android:textColor="#A5B4C7" android:textSize="9sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌖ Map" android:textColor="#A5B4C7" android:textSize="9sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▥ Trip" android:textColor="#A5B4C7" android:textSize="9sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="♫ Media" android:textColor="#A5B4C7" android:textSize="9sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙ Settings" android:textColor="#A5B4C7" android:textSize="9sp"/></LinearLayout>
    </LinearLayout>
</ScrollView>
