<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070B0F" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="42dp" android:layout_height="42dp" android:background="#0877D9" android:gravity="center" android:text="M" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MotoMonitor" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RIDE • MONITOR • EXPLORE" android:textColor="#00AFFF" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="⌖\nGPS" android:textColor="#00F58C" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:gravity="center" android:text="♢\nBMS" android:textColor="#C8D3E2" android:textSize="11sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:gravity="center" android:text="♢\nVOTOL" android:textColor="#C8D3E2" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TODAY • RIDE DASHBOARD" android:textColor="#718096" android:textSize="11sp" />
            <TextView android:id="@+id/votolStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_dashboard_chip" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="VOTOL OFF" android:textColor="#00CFFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/jkStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/bg_dashboard_ready" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="BMS OFF" android:textColor="#00F58C" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_dashboard_card" android:gravity="center" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_dashboard_chip" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="SPORT" android:textColor="#00CFFF" android:textSize="11sp" android:textStyle="bold" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_dashboard_ready" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="READY" android:textColor="#00F58C" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <FrameLayout android:layout_width="270dp" android:layout_height="270dp" android:layout_marginTop="8dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="8dp" android:background="@drawable/bg_dashboard_gauge" />
                <View android:layout_width="242dp" android:layout_height="242dp" android:layout_gravity="center" android:background="#070B0F" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/speedValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans" android:text="00" android:textColor="#FFFFFF" android:textSize="72sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km/h" android:textColor="#A5B4C7" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="ECO • LIVE GPS" android:textColor="#00F58C" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SOC" android:textColor="#91A4C5" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/bmsSocValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="monospace" android:text="-- %" android:textColor="#00F58C" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="BATTERY" android:textColor="#718096" android:textSize="9sp" />
            </LinearLayout>
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VOLTAGE" android:textColor="#91A4C5" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/bmsVoltageValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="monospace" android:text="--.-- V" android:textColor="#00CFFF" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="TOTAL PACK" android:textColor="#718096" android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_dashboard_card" android:orientation="horizontal" android:padding="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT" android:textColor="#718096" android:textSize="9sp"/><TextView android:id="@+id/bmsCurrentValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 A" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POWER" android:textColor="#718096" android:textSize="9sp"/><TextView android:id="@+id/bmsPowerValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 W" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Δ CELL" android:textColor="#718096" android:textSize="9sp"/><TextView android:id="@+id/bmsDeltaValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.000 V" android:textColor="#00F58C" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BMS TEMP" android:textColor="#718096" android:textSize="9sp"/><TextView android:id="@+id/bmsTempValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- °C" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/bmsChargeEstimate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="#0C2028" android:padding="10dp" android:text="ESTIMASI CHARGE 0–100%    --" android:textColor="#00CFFF" android:textSize="11sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="155dp" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VOTOL TELEMETRY" android:textColor="#00CFFF" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="monospace" android:text="Motor RPM\n0\n\nPhase Current\n0.0 A\n\nThrottle\n0 %" android:textColor="#DCE5F2" android:textSize="11sp" />
            </LinearLayout>
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="155dp" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYSTEM TEMP" android:textColor="#00CFFF" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/systemTempValues" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="monospace" android:text="Controller     -- °C\n\nMotor              -- °C\n\nBattery            -- °C" android:textColor="#DCE5F2" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRIP / PERJALANAN" android:textColor="#00CFFF" android:textSize="12sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><EditText android:id="@+id/tripOrigin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Asal" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#718096" android:textSize="12sp" /><EditText android:id="@+id/tripDestination" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:hint="Tujuan" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#718096" android:textSize="12sp" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal"><TextView android:id="@+id/tripDistance" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Jarak     0.0 km" android:textColor="#00F58C" android:textSize="12sp"/><TextView android:id="@+id/tripTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Waktu     00:00" android:textColor="#FFFFFF" android:textSize="12sp"/></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal"><Button android:id="@+id/startTrip" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="START TRIP" android:textSize="11sp"/><Button android:id="@+id/endTrip" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="END TRIP" android:textSize="11sp"/></LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYSTEM LOG / STATUS" android:textColor="#91A4C5" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="8dp" android:background="#080D13" android:fontFamily="monospace" android:padding="10dp" android:scrollbars="vertical" android:text="Ready. VOTOL SPP + JK BMS BLE." android:textColor="#56A8FF" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><Button android:id="@+id/votolScan" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="SCAN VOTOL" android:textSize="10sp"/><Button android:id="@+id/votolDisconnect" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="DISCONNECT" android:textSize="10sp"/></LinearLayout>
        <TextView android:id="@+id/votolDevices" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="7dp" android:text="No VOTOL devices scanned." android:textColor="#718096" android:textSize="10sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/jkScan" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="SCAN JK BMS" android:textSize="10sp"/><Button android:id="@+id/jkDisconnect" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="DISCONNECT" android:textSize="10sp"/></LinearLayout>
        <TextView android:id="@+id/jkDevices" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="7dp" android:text="No JK BMS devices scanned." android:textColor="#718096" android:textSize="10sp" />
        <Button android:id="@+id/exportLog" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:text="EXPORT LOG" android:textSize="10sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:background="#0C121A" android:gravity="center" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂\nDashboard" android:textColor="#00CFFF" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣\nBMS" android:textColor="#A5B4C7" android:textSize="9sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙\nVOTOL" android:textColor="#A5B4C7" android:textSize="9sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌖\nMap" android:textColor="#A5B4C7" android:textSize="9sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▥\nTrip" android:textColor="#A5B4C7" android:textSize="9sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="♫\nMedia" android:textColor="#A5B4C7" android:textSize="9sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙\nSettings" android:textColor="#A5B4C7" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
